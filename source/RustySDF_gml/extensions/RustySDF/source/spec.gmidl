module RustySDF;

/// Font load / free / fallback chain.
function rusty_sdf_load_font([type_hint=buffer] data: gmval): real;
function rusty_sdf_free_font(font_handle: real) : real;
function rusty_sdf_add_fallback(font_handle: real, fallback_handle: real) : real;
function rusty_sdf_get_font_glyph_count(font_handle: real) : real;

/// HarfBuzz shaping + bidi.
function rusty_sdf_shape_text(font_handle: real, text: string, font_size: real) : real;
function rusty_sdf_free_shape(shape_handle: real) : real;
function rusty_sdf_get_shape_width(shape_handle: real) : real;
function rusty_sdf_get_shape_height(shape_handle: real) : real;
function rusty_sdf_get_shape_glyph_count(shape_handle: real) : real;
function rusty_sdf_get_shape_glyphs_buffer(shape_handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_set_bidi_mode(mode: real) : real;

/// SDF/MSDF render buffer + params.
function rusty_sdf_set_buffer(buffer_ptr: pointer, buf_w: real, buf_h: real) : real;
function rusty_sdf_set_params(padding: real, spread: real) : real;
function rusty_sdf_set_mode(mode: real) : real;
function rusty_sdf_get_mode() : real;
function rusty_sdf_get_buffer_bpp() : real;

function rusty_sdf_get_glyph_bounds(font_handle: real, glyph_id: real, font_size: real): object;
function rusty_sdf_render_glyph(font_handle: real, glyph_id: real, font_size: real) : real;
function rusty_sdf_render_char(font_handle: real, char_code: real, font_size: real) : real;

/// Async glyph render queue (poll in Begin Step — keep GPU upload off Draw).
function rusty_sdf_request_glyph(font_handle: real, glyph_id: real, font_size: real, padding: real, spread: real, mode: real) : real;
function rusty_sdf_poll_glyph(): object;
function rusty_sdf_poll_glyph_pixels([type_hint=buffer] dst: gmval): real;
function rusty_sdf_poll_glyph_pixels_strided([type_hint=buffer] dst: gmval, stride_w: real, stride_h: real): real;

function rusty_sdf_measure_text(font_handle: real, text: string, font_size: real): object;
function rusty_sdf_ping() : string;
/// Last native error string (also available as auto RustySDF_get_last_error export).
function rusty_sdf_get_last_error() : string;

/// Atlas (CPU pack; GML owns surfaces).
function rusty_sdf_atlas_init(width: real, height: real, padding: real) : real;
function rusty_sdf_atlas_reset() : real;
function rusty_sdf_atlas_clear() : real;
function rusty_sdf_atlas_get_version() : real;
function rusty_sdf_atlas_page_count() : real;
function rusty_sdf_atlas_ensure_glyph(font_handle: real, glyph_id: real, base_size: real, spread: real, mode: real, async_flag: real) : real;
function rusty_sdf_atlas_lookup(font_handle: real, glyph_id: real, base_size: real, spread: real): object;
function rusty_sdf_atlas_commit_glyph(font_handle: real, glyph_id: real, base_size: real, spread: real, width: real, height: real, raw_w: real, raw_h: real, x_min: real, y_max: real) : real;
function rusty_sdf_atlas_poll_dirty_meta([type_hint=buffer] dst: gmval): real;
function rusty_sdf_atlas_poll_dirty_pixels([type_hint=buffer] dst: gmval): real;

/// Rich text (parse + layout + vertices).
function rusty_sdf_rich_create() : real;
function rusty_sdf_rich_free(handle: real) : real;
function rusty_sdf_rich_set_text(handle: real, text: string) : real;
function rusty_sdf_rich_set_font(handle: real, font_handle: real, font_size: real, base_size: real, spread: real) : real;
function rusty_sdf_rich_set_layout(handle: real, max_width: real, line_height: real, letter_spacing: real, halign: real, valign: real) : real;
function rusty_sdf_rich_set_default_style(handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_set_async(handle: real, enabled: real) : real;
function rusty_sdf_rich_set_plain(handle: real, enabled: real) : real;
function rusty_sdf_rich_set_config(handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_register_image(handle: real, name: string) : real;
function rusty_sdf_rich_set_image_metrics(handle: real, spr_w: real, spr_h: real, xoff: real, yoff: real) : real;
function rusty_sdf_rich_clear_images(handle: real) : real;
function rusty_sdf_rich_build(handle: real) : real;
function rusty_sdf_rich_get_metrics_buffer(handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_get_page_byte_size(handle: real, page: real) : real;
function rusty_sdf_rich_write_page_vertices(handle: real, page: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_get_images_buffer(handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_get_image_name(handle: real, index: real) : string;
function rusty_sdf_rich_get_glyph_meta_buffer(handle: real, buffer_ptr: pointer, buffer_len: real) : real;
function rusty_sdf_rich_get_plain_text(handle: real) : string;
